

SELECT
    table_schema,
    table_name,
    column_name
FROM information_schema.columns
WHERE table_schema = 'DB명'
  AND column_name IN ('create_date', 'created_at')
ORDER BY table_name, column_name;

---

SELECT
    CONCAT(
        'SELECT ''', c.table_name, ''' AS table_name, ',
        '''', c.column_name, ''' AS date_column, ',
        'DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'') AS ym, ',
        'COUNT(*) AS row_count, ',
        'ROUND(COUNT(*) * ', t.avg_row_length, ' / 1024 / 1024, 2) AS estimated_data_mb ',
        'FROM `', c.table_schema, '`.`', c.table_name, '` ',
        'WHERE `', c.column_name, '` IS NOT NULL ',
        'GROUP BY DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'')'
    ) AS monthly_sql
FROM information_schema.columns c
JOIN information_schema.tables t
  ON t.table_schema = c.table_schema
 AND t.table_name = c.table_name
WHERE c.table_schema = 'DB명'
  AND c.column_name IN ('create_date', 'created_at')
  AND t.table_type = 'BASE TABLE'
ORDER BY c.table_name;

-------

SELECT GROUP_CONCAT(monthly_sql SEPARATOR ' UNION ALL ')
FROM (
    SELECT
        CONCAT(
            'SELECT ''', c.table_name, ''' AS table_name, ',
            '''', c.column_name, ''' AS date_column, ',
            'DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'') AS ym, ',
            'COUNT(*) AS row_count, ',
            'ROUND(COUNT(*) * ', t.avg_row_length, ' / 1024 / 1024, 2) AS estimated_data_mb ',
            'FROM `', c.table_schema, '`.`', c.table_name, '` ',
            'WHERE `', c.column_name, '` IS NOT NULL ',
            'GROUP BY DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'')'
        ) AS monthly_sql
    FROM information_schema.columns c
    JOIN information_schema.tables t
      ON t.table_schema = c.table_schema
     AND t.table_name = c.table_name
    WHERE c.table_schema = 'DB명'
      AND c.column_name IN ('create_date', 'created_at')
      AND t.table_type = 'BASE TABLE'
) x;