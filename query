SET SESSION group_concat_max_len = 1000000;

SELECT GROUP_CONCAT(
    CONCAT(
        'SELECT ''', c.table_name, ''' AS table_name, ',
        '''', c.column_name, ''' AS date_column, ',
        'DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'') AS ym, ',
        'COUNT(*) AS row_count, ',
        'ROUND(COUNT(*) * ', IFNULL(t.avg_row_length,0), ' /1024/1024, 2) AS estimated_mb ',
        'FROM `', c.table_schema, '`.`', c.table_name, '` ',
        'WHERE `', c.column_name, '` IS NOT NULL ',
        'GROUP BY DATE_FORMAT(`', c.column_name, '`, ''%Y-%m'')'
    )
    SEPARATOR ' UNION ALL '
) INTO @sql
FROM information_schema.columns c
JOIN information_schema.tables t
  ON t.table_schema = c.table_schema
 AND t.table_name = c.table_name
WHERE c.table_schema = 'kwaterprod'
  AND c.column_name IN ('create_date','created_at');

PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;